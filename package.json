{
  "name": "dsh-session-purge",
  "version": "0.1.0",
  "description": "DSH Web plugin: purge archived sessions for real and reclaim attachment blobs no remaining session references.",
  "license": "MIT",
  "author": "w1w218",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w1w218/dsh-session-purge.git"
  },
  "homepage": "https://github.com/w1w218/dsh-session-purge#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session",
    "cleanup",
    "attachments"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node test/self-test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  }
}
